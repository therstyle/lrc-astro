---
import Layout from '../components/Layout.astro';
import error404 from '../data/error404.data';

const { title, headline, cta, showBottom } = error404
---

<Layout title={title} showBottom={showBottom}>
  <div class="error-content" slot="main">
    <h1>{headline}</h1>
    <p><a class="btn" href="/">{cta}</a></p>
  </div>
</Layout>
