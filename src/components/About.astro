---
import home from '../data/home.data';
const { about } = home;
---


<section class="about" id="about">
  <div class="wrapper">
    <div class="about-left">
      <img src={about.image.path} alt={about.image.alt} fetchpriority="high" />
    </div>

    <div class="about-right">
      <article>
        <header>
          <h2><small>{about.headline.small}</small><br />{about.headline.main}</h2>
        </header>

        {about.text.map((paragraph) => <p>{paragraph}</p>)}
      </article>
    </div>
  </div>
</section>
